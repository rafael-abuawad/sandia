# Written by `npx convex dev`. Do not edit by hand.
NEXT_PUBLIC_CONVEX_URL=

# Public origin used for canonical URLs, the sitemap, and Open Graph.
# Set this to the production https origin before submitting the sitemap.
# NEXT_PUBLIC_APP_URL=https://example.com
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Privy app id. Set the same value on Convex as PRIVY_APP_ID.
NEXT_PUBLIC_PRIVY_APP_ID=

# Sandia Send on Robinhood Chain. Required for batch sends.
NEXT_PUBLIC_SANDIA_SEND_ADDRESS=

# Across integrator id fallback (2-byte hex). Convex ACROSS_INTEGRATOR_ID wins when set.
NEXT_PUBLIC_ACROSS_INTEGRATOR_ID=

# Convex only:
# npx convex env set OPENROUTER_API_KEY <key>
# npx convex env set PRIVY_APP_ID <same-as-NEXT_PUBLIC_PRIVY_APP_ID>
# PRIVY_APP_SECRET is Convex-only, for the same Privy app as PRIVY_APP_ID.
# Never set it as NEXT_PUBLIC_ or in the Next.js client. The app does not read it yet.
# npx convex env set PRIVY_APP_SECRET <app-secret>
# npx convex env set SANDIA_NONCE_SECRET <secret>
# npx convex env set ACROSS_API_KEY <key>
# npx convex env set ACROSS_INTEGRATOR_ID 0xdead
# npx convex env set ZEROX_API_KEY <key>
