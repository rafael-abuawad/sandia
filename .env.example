# Convex — written by `npx convex dev` (required)
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=

# App URL used by ConnectKit metadata (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WalletConnect Cloud project id — https://cloud.walletconnect.com (required for production wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Across Protocol integrator id — 2-byte hex, e.g. 0xdead (register before production)
# NEXT_PUBLIC_ACROSS_INTEGRATOR_ID=
