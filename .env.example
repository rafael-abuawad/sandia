# Convex — written by `npx convex dev` (required)
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=

# App URL (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privy app for email sign-in and the embedded wallet. Same id on Convex as PRIVY_APP_ID.
# Payer WalletConnect, if used, is enabled in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Across Protocol integrator id — 2-byte hex, e.g. 0xdead (register before production)
# Prefer Convex: npx convex env set ACROSS_INTEGRATOR_ID 0xdead
# NEXT_PUBLIC_ACROSS_INTEGRATOR_ID=

# HMAC secret for wallet-claim nonces. Same value on Convex.
# SANDIA_NONCE_SECRET=

# Convex only (never NEXT_PUBLIC):
# npx convex env set PRIVY_APP_ID <same-as-NEXT_PUBLIC_PRIVY_APP_ID>
# npx convex env set ACROSS_API_KEY <key>
# npx convex env set ZEROX_API_KEY <key>
# npx convex env set SANDIA_NONCE_SECRET <secret>
