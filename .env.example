# Convex — written by `npx convex dev` (required)
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=

# App URL used in Privy metadata (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privy App ID — https://dashboard.privy.io (required)
# Also set the same value on Convex: npx convex env set PRIVY_APP_ID <app-id>
NEXT_PUBLIC_PRIVY_APP_ID=

# Across Protocol integrator id — 2-byte hex, e.g. 0xdead (register before production)
# Prefer Convex: npx convex env set ACROSS_INTEGRATOR_ID 0xdead
# NEXT_PUBLIC_ACROSS_INTEGRATOR_ID=

# Leave unset to keep Privy. `zerodev` mounts ZeroDev Kernel 4337 and ConnectKit.
# NEXT_PUBLIC_SANDIA_AUTH=privy
# NEXT_PUBLIC_ZERODEV_PROJECT_ID=
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Convex only (never NEXT_PUBLIC):
# npx convex env set ACROSS_API_KEY <key>
# npx convex env set ZEROX_API_KEY <key>
# npx convex env set SANDIA_NONCE_SECRET <secret>
# npx convex env set SANDIA_JWT_ISS https://your-host
# npx convex env set SANDIA_JWKS_URL https://your-host/api/auth/sandia/jwks
# npx convex env set SANDIA_JWT_AUD sandia
# SANDIA_JWT_PRIVATE_KEY=
# SANDIA_JWT_PUBLIC_KEY=
# SANDIA_JWT_ISS=
# SANDIA_JWT_AUD=sandia
